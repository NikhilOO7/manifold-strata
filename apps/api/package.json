{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/__tests__/*.test.ts\"",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5433/knowledge_graph_test} node --import tsx --test \"src/__tests__/db/*.test.ts\"",
    "mcp": "tsx src/mcp/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed:load": "tsx src/db/seed-load.ts",
    "bench:retrieval": "tsx src/db/bench-retrieval.ts",
    "eval": "tsx src/eval/run.ts",
    "auth:bootstrap": "tsx src/auth/bootstrap.ts",
    "models:compare": "tsx src/services/model-bench.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.74",
    "@hono/node-server": "^1.19.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "5.0.104",
    "dotenv": "^17.2.3",
    "drizzle-orm": "latest",
    "hono": "latest",
    "ollama-ai-provider": "1.2.0",
    "pdf-parse": "latest",
    "postgres": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pdf-parse": "latest",
    "drizzle-kit": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
